/agent/
*test*.py
# Keep management write contract/transaction regression suites reviewable.
!/backend/tests/test_management_site_update.py
!/backend/tests/test_management_role_user_update.py
!/backend/tests/test_management_site_delete.py
!/backend/tests/test_management_role_user_delete.py
# Keep system monitoring lifecycle and worker regression tests reviewable.
!/backend/tests/test_monitor.py
!/backend/tests/test_socketio.py
/test/
# macOS Finder metadata.
.DS_Store

# Publish SYSTEM/config.yaml with development-only defaults; keep local secrets out of Git.
.env
.env.*
!.env.example
# Python dependencies and generated verification/package output.
/backend/.venv/
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
/backend/.coverage
/backend/htmlcov/
/backend/dist/
/backend/*.egg-info/
# Keep generated MMDB caches out of Git; ship the offline source archive and notices.
*.mmdb
*.mmdb.*
!/backend/SYSTEM/geoip/City.mmdb.gz
# Legacy SQLite filenames have no extension; they are still local database data.
/backend/porfolio_modern
/backend/porfolio_modern-journal
/backend/porfolio_modern-wal
/backend/porfolio_modern-shm
/backend/SYSTEM/models/sqlite/
# Local SQLite databases and their journal/WAL files.
*.db
*.db-*
*.db3
*.db3-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Python bytecode cache.
__pycache__/
*.py[cod]
