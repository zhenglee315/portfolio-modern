/agent/
# Regression source belongs in version control; evidence stays under agent/.
/test/
*test*
# Maintained suites and their configs must remain reviewable despite broad local test ignores.
!/backend/tests/
!/backend/tests/**
!/frontend/tests/
!/frontend/tests/**
!/frontend/vitest.config.ts
!/frontend/vitest.integration.config.ts
!/frontend/playwright.config.ts
# macOS Finder metadata.
.DS_Store

# Publish SYSTEM/config.yaml with development-only defaults; keep local secrets out of Git.
.env
.env.*
!.env.example
# Python dependencies and generated verification/package output.
/backend/.venv/
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
/backend/.coverage
/backend/htmlcov/
/backend/dist/
/backend/*.egg-info/
# Keep generated MMDB caches out of Git; ship the offline source archive and notices.
*.mmdb
*.mmdb.*
!/backend/SYSTEM/geoip/City.mmdb.gz
# Legacy SQLite filenames have no extension; they are still local database data.
/backend/porfolio_modern
/backend/porfolio_modern-journal
/backend/porfolio_modern-wal
/backend/porfolio_modern-shm
/backend/SYSTEM/models/sqlite/
# Local SQLite databases and their journal/WAL files.
*.db
*.db-*
*.db3
*.db3-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Python bytecode cache.
__pycache__/
*.py[cod]

# Small licensed GeoIP test fixture, never the generated production database.
!/backend/tests/fixtures/GeoIP2-City-Test.mmdb
