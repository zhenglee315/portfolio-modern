# Public browser API prefix. Production hosting must route this prefix to FastAPI.
VITE_API_BASE_URL=/api

# Local development proxy only; this value is not included in browser bundles.
API_PROXY_TARGET=http://127.0.0.1:8080

# Server-only public API origin used for static content builds.
API_BUILD_TARGET=http://127.0.0.1:8080

# Optional public website origin for canonical and alternate-language links.
# Set the deployed HTTPS origin; an empty value omits absolute SEO links.
VITE_PUBLIC_SITE_URL=
