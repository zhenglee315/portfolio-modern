# Dynamic SSR hosting example. Keep private origins in deployment configuration.
# Publish only build/client as static files; run npm start with build/server available to Node.
server {
    listen 80;
    root /usr/share/nginx/html;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_static on;

    # Browser API requests remain separate from public document rendering.
    location /api/ {
        proxy_pass http://backend:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }

    # Hashed assets are immutable; missing assets retain their actual status.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # HTML and .data requests use Node so publication/default changes apply immediately.
    location / {
        try_files $uri @portfolio;
    }
    location @portfolio {
        proxy_pass http://frontend:5173;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }
}
