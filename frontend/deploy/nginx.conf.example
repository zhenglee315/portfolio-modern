# Generic static hosting example. Replace root/upstream in private deployment configuration.
# Serve only build/client; source directories and server build artifacts are not public files.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Public API routing is separate from the SPA fallback; errors retain their status.
    location /api/ {
        proxy_pass http://backend:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }

    # Hashed assets are immutable; unknown assets must not return application HTML.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Route data and HTML require revalidation after publishing a new static snapshot.
    location ~ \.data$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /__spa-fallback.html;
        add_header Cache-Control "no-cache";
    }
}
