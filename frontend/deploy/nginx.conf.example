# Dynamic SSR hosting example. Keep private origins in deployment configuration.
# Publish only build/client as static files; run npm start with build/server available to Node.
server {
    listen 80;
    root /usr/share/nginx/html;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_static on;

    # Match the browser's /api/socket.io path and retain its public Origin/Host.
    location /api/socket.io/ {
        proxy_pass http://backend:8080/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    # Browser API requests remain separate from public document rendering.
    location /api/ {
        proxy_pass http://backend:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Direct Internet -> Nginx -> API: overwrite client-supplied IP headers.
        # Keep the API reachable only from Nginx (loopback/private network + firewall).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 15s;
    }

    # Hashed assets are immutable; missing assets retain their actual status.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # HTML and .data requests use Node so publication/default changes apply immediately.
    location / {
        try_files $uri @portfolio;
    }
    location @portfolio {
        proxy_pass http://frontend:5173;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }
}
