{
  "name": "portfolio-modern-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:cow": "vite --config vite.cow-workspace.config.ts",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config=playwright.dev.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@tanstack/react-query": "5.104.1",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "i18next": "26.4.2",
    "isbot": "5.1.36",
    "react": "19.2.8",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "sirv": "3.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.0"
}
